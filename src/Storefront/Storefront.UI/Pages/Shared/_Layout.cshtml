<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Online Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">🛒 Online Store</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-light" asp-page="/Index">Catalog</a></li>
                        @if (Context.Session.IsLoggedIn())
                        {
                            <li class="nav-item"><a class="nav-link text-light" asp-page="/Orders/Index">My Orders</a></li>
                        }
                        @if (Context.Session.IsAdmin())
                        {
                            <li class="nav-item"><a class="nav-link text-warning" asp-page="/Admin/Products">Products</a></li>
                            <li class="nav-item"><a class="nav-link text-warning" asp-page="/Admin/Inventory">Inventory</a></li>
                            <li class="nav-item"><a class="nav-link text-warning" asp-page="/Admin/Payment">Payment Switch</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (Context.Session.IsLoggedIn())
                        {
                            <li class="nav-item"><span class="nav-link text-info">@Context.Session.Username() (@Context.Session.Role())</span></li>
                            <li class="nav-item"><a class="nav-link text-light" asp-page="/Account/Logout">Logout</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-light" asp-page="/Account/Login">Login</a></li>
                            <li class="nav-item"><a class="nav-link text-light" asp-page="/Account/Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">&copy; @DateTime.Now.Year - Online Store Platform</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
