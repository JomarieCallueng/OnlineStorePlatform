@page
@model Storefront.UI.Pages.Orders.DetailsModel
@{ ViewData["Title"] = "Order"; }
@if (Model.InProgress)
{
    <meta http-equiv="refresh" content="3" />
}

<p><a asp-page="/Orders/Index">&laquo; Back to my orders</a></p>

@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> }

@if (Model.Order is { } o)
{
    <h1>Order <code>@o.Id.ToString().Substring(0, 8)</code></h1>
    <p>
        Status: <span class="badge bg-@StatusColor(o.Status) fs-6">@o.Status</span>
        @if (Model.InProgress) { <span class="text-muted ms-2"><em>saga in progress &mdash; this page auto-refreshes</em></span> }
    </p>

    <h5 class="mt-4">Items</h5>
    <table class="table">
        <thead><tr><th>Product</th><th>Qty</th><th>Unit price</th><th>Line total</th></tr></thead>
        <tbody>
        @foreach (var l in o.Lines)
        {
            <tr><td>@l.ProductName</td><td>@l.Quantity</td><td>@l.UnitPrice.ToString("C")</td><td>@((l.UnitPrice * l.Quantity).ToString("C"))</td></tr>
        }
        </tbody>
        <tfoot><tr><th colspan="3" class="text-end">Total</th><th>@o.Total.ToString("C")</th></tr></tfoot>
    </table>

    <h5 class="mt-4">Saga status history</h5>
    <ul class="list-group">
        @foreach (var h in o.History)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span><span class="badge bg-@StatusColor(h.Status) me-2">@h.Status</span>@h.Note</span>
                <small class="text-muted">@h.Timestamp.ToLocalTime().ToString("HH:mm:ss")</small>
            </li>
        }
    </ul>
}
@functions {
    static string StatusColor(string s) => s switch
    {
        "Confirmed" => "success",
        "Cancelled" => "danger",
        "Compensating" => "warning",
        "StockReserved" => "info",
        "Pending" => "secondary",
        _ => "secondary"
    };
}
