# Copy to .env to override the development defaults baked into docker-compose.yml.
# SQL Server SA password must meet complexity (>=8 chars, upper, lower, digit).
SA_PASSWORD=Your_Strong_Pass123
# Shared JWT signing key (HS256, >=32 bytes). Override in any real deployment.
JWT_KEY=store-dev-signing-key-please-override-in-production-0123456789
