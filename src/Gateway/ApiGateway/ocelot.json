{
  "Routes": [
    {
      "UpstreamPathTemplate": "/auth/v1/login",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/auth/v1/login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "identity", "Port": 8080 } ],
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 5
      }
    },
    {
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "DownstreamPathTemplate": "/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "identity", "Port": 8080 } ]
    },
    {
      "UpstreamPathTemplate": "/catalog/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT" ],
      "DownstreamPathTemplate": "/catalog/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "catalog", "Port": 8080 } ]
    },
    {
      "UpstreamPathTemplate": "/inventory/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT" ],
      "DownstreamPathTemplate": "/inventory/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "inventory", "Port": 8080 } ],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer", "AllowedScopes": [] }
    },
    {
      "UpstreamPathTemplate": "/order/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT" ],
      "DownstreamPathTemplate": "/order/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "order", "Port": 8080 } ],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer", "AllowedScopes": [] }
    },
    {
      "UpstreamPathTemplate": "/payment/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT" ],
      "DownstreamPathTemplate": "/payment/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "payment", "Port": 8080 } ],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer", "AllowedScopes": [] }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8080",
    "RateLimitOptions": {
      "QuotaExceededMessage": "Too many requests. Please slow down and try again shortly.",
      "HttpStatusCode": 429,
      "DisableRateLimitHeaders": false
    }
  }
}
