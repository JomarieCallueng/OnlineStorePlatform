{
  "info": {
    "name": "Online Store Platform",
    "_postman_id": "a1b2c3d4-0000-4000-8000-000000000001",
    "description": "Main flows through the API gateway (http://localhost:8080). Run Login first to capture a token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "productId", "value": "11111111-1111-1111-1111-111111111111" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (new customer)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{gateway}}/auth/v1/register",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"Passw0rd!\"\n}" }
          }
        },
        {
          "name": "Login (admin) -> saves token",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var j = pm.response.json();",
            "pm.collectionVariables.set('token', j.accessToken);",
            "pm.test('got token', function(){ pm.expect(j.accessToken).to.be.a('string'); });"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{gateway}}/auth/v1/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}" }
          }
        },
        {
          "name": "Login (customer) -> saves token",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var j = pm.response.json();",
            "pm.collectionVariables.set('token', j.accessToken);"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{gateway}}/auth/v1/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"customer\",\n  \"password\": \"Customer123!\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "List products (public)",
          "request": { "method": "GET", "url": "{{gateway}}/catalog/v1/products" }
        },
        {
          "name": "Create product (admin)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}" } ] },
            "url": "{{gateway}}/catalog/v1/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Webcam\",\n  \"price\": 59.99,\n  \"isActive\": true\n}" }
          }
        }
      ]
    },
    {
      "name": "Order",
      "item": [
        {
          "name": "Place order (saves orderId)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var j = pm.response.json();",
            "pm.collectionVariables.set('orderId', j.id);"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}" } ] },
            "url": "{{gateway}}/order/v1/orders",
            "body": { "mode": "raw", "raw": "{\n  \"items\": [ { \"productId\": \"{{productId}}\", \"quantity\": 2 } ]\n}" }
          }
        },
        {
          "name": "Get order (status + history)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}" } ] },
            "url": "{{gateway}}/order/v1/orders/{{orderId}}"
          }
        },
        {
          "name": "List my orders",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}" } ] },
            "url": "{{gateway}}/order/v1/orders"
          }
        }
      ]
    },
    {
      "name": "Payment (failure switch)",
      "item": [
        {
          "name": "Turn failures ON",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}" } ] },
            "url": "{{gateway}}/payment/v1/simulate-failure",
            "body": { "mode": "raw", "raw": "{ \"enabled\": true }" }
          }
        },
        {
          "name": "Turn failures OFF",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}" } ] },
            "url": "{{gateway}}/payment/v1/simulate-failure",
            "body": { "mode": "raw", "raw": "{ \"enabled\": false }" }
          }
        }
      ]
    },
    {
      "name": "Inventory (admin)",
      "item": [
        {
          "name": "Get stock",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}" } ] },
            "url": "{{gateway}}/inventory/v1/stock"
          }
        },
        {
          "name": "Adjust stock",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}" } ] },
            "url": "{{gateway}}/inventory/v1/stock/{{productId}}",
            "body": { "mode": "raw", "raw": "{ \"quantityOnHand\": 200 }" }
          }
        }
      ]
    },
    {
      "name": "Gateway security checks",
      "item": [
        {
          "name": "Place order anonymous (expect 401)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{gateway}}/order/v1/orders",
            "body": { "mode": "raw", "raw": "{ \"items\": [ { \"productId\": \"{{productId}}\", \"quantity\": 1 } ] }" }
          }
        },
        {
          "name": "Admin action as customer (expect 403)",
          "description": "Login as customer first, then run this.",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}" } ] },
            "url": "{{gateway}}/catalog/v1/products",
            "body": { "mode": "raw", "raw": "{ \"name\": \"Nope\", \"price\": 1.00, \"isActive\": true }" }
          }
        }
      ]
    }
  ]
}
